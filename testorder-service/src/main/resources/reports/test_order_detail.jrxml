<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:c="http://jasperreports.sourceforge.net/jasperreports/components"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="test_order_detail"
        pageWidth="595"
        pageHeight="842"
        columnWidth="555"
        leftMargin="20"
        rightMargin="20"
        topMargin="20"
        bottomMargin="20">
    <!--  Font cấu hình mặc định hỗ trợ tiếng Việt -->
    <property name="net.sf.jasperreports.default.font.name" value="DejaVu Sans"/>
    <property name="net.sf.jasperreports.default.pdf.font.name" value="DejaVuSans.ttf"/>
    <property name="net.sf.jasperreports.default.pdf.encoding" value="Identity-H"/>
    <property name="net.sf.jasperreports.default.pdf.embedded" value="true"/>

    <!-- ==================== SUBDATASET ==================== -->
    <subDataset name="TestResultDataset">
        <field name="parameterName" class="java.lang.String"/>
        <field name="value" class="java.lang.Double"/>
        <field name="flagStatus" class="sum25.group03.testorderservice.enums.FlagStatus"/>
<!--        <field name="status" class="sum25.group03.testorderservice.enums.TestResultStatus"/>-->
<!--        <field name="commentTexts" class="java.lang.String"/>-->
        <field name="reviewText" class="java.lang.String"/>
    </subDataset>


    <!-- ==================== PARAMETERS ==================== -->
    <parameter name="PATIENT_NAME" class="java.lang.String"/>
    <parameter name="REPORT_DATE" class="java.lang.String"/>


    <!-- ==================== ROOT DATASET FIELDS ==================== -->
    <field name="id" class="java.lang.Long"/>
    <field name="patientName" class="java.lang.String"/>
    <field name="gender" class="java.lang.String"/>
    <field name="dateOfBirth" class="java.time.LocalDate"/>
    <field name="phoneNumber" class="java.lang.String"/>
    <field name="status" class="sum25.group03.testorderservice.enums.TestOrderStatus"/>
    <field name="createdBy" class="java.lang.Long"/>
    <field name="createdAt" class="java.time.LocalDateTime"/>
    <field name="runBy" class="java.lang.Long"/>
    <field name="runOn" class="java.time.LocalDate"/>
    <field name="results" class="java.util.List"/>
    <field name="orderComments" class="java.lang.String"/>


    <!-- ==================== TITLE ==================== -->
    <title>
        <band height="90">
            <!-- Header với nền xanh dương -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="70" backcolor="#1F3B63" mode="Opaque"/>
            </rectangle>

            <!-- Logo bên trái -->
            <image>
                <reportElement x="10" y="5" width="50" height="50" mode="Transparent"/>
                <imageExpression><![CDATA["images/logo.png"]]></imageExpression>
            </image>


            <!-- Thông tin bệnh viện bên phải -->
            <staticText>
                <reportElement x="70" y="5" width="480" height="20" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[BỆNH VIỆN ABC]]></text>
            </staticText>


            <staticText>
                <reportElement x="70" y="25" width="480" height="18" forecolor="#FFFFFF" />
                <textElement>
                    <font fontName="DejaVu Sans"
                          pdfFontName="fonts/DejaVuSans.ttf"
                          pdfEncoding="Identity-H"
                          isPdfEmbedded="true"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[123 Đường Sức Khỏe, Phường 1, Quận 2]]></text>
            </staticText>


            <staticText>
                <reportElement x="70" y="42" width="480" height="18" forecolor="#FFFFFF"/>
                <text><![CDATA[Hotline: 0123 456 789 – Website: www.benhvienabc.com]]></text>
            </staticText>
        </band>
    </title>

    <!-- ================= HEADER ================ -->
    <pageHeader>
        <band height="60">
<!--            <textField>-->
<!--                <reportElement x="0" y="10" width="555" height="20"/>-->
<!--                <textElement textAlignment="Center">-->
<!--                    <font fontName="DejaVu Sans"-->
<!--                          pdfFontName="fonts/DejaVuSans.ttf"-->
<!--                          pdfEncoding="Identity-H"-->
<!--                          isPdfEmbedded="true"-->
<!--                          size="14" isBold="true"/>-->
<!--                </textElement>-->
<!--                <textFieldExpression><![CDATA[LABORATORY TEST REPORT]]></textFieldExpression>-->
<!--            </textField>-->
            <staticText>
                <reportElement x="0" y="10" width="555" height="20" forecolor="#1F3B63"></reportElement>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans"
                          pdfFontName="fonts/DejaVuSans.ttf"
                          pdfEncoding="Identity-H"
                          isPdfEmbedded="true"
                          size="14"
                          isBold="true"/>
                </textElement>
                <text><![CDATA[LABORATORY TEST REPORT]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="555" height="20" forecolor="#1F3B63"/>
                <textElement textAlignment="Left">
                    <font fontName="DejaVu Sans"
                          pdfFontName="fonts/DejaVuSans.ttf"
                          pdfEncoding="Identity-H"
                          isPdfEmbedded="true"
                          isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Date: " + ($P{REPORT_DATE} != null ? $P{REPORT_DATE} : "")]]></textFieldExpression>
            </textField>
        </band>

    </pageHeader>

    <!-- ==================== DETAIL ==================== -->
    <detail>
        <band height="140">
<!--            <staticText>-->
<!--                <reportElement x="0" y="0" width="555" height="20"/>-->
<!--                <text><![CDATA[Order Information]]></text>-->
<!--            </staticText>-->

            <!-- Patient Info Box -->
            <frame>
                <reportElement x="0" y="0" width="270" height="110" backcolor="#BDC3C7" mode="Opaque"/>
                <staticText>
                    <reportElement x="0" y="0" width="270" height="20" forecolor="#1F3B63" backcolor="#AAB0B7" mode="Opaque"  />
                    <textElement textAlignment="Center">
                        <font isBold="true" size="12"/>
                    </textElement>
                    <text ><![CDATA[PATIENT INFORMATION]]></text>
                </staticText>

                <textField>
                    <reportElement x="10" y="25" width="250" height="15"/>
                    <textElement>
                        <font fontName="DejaVu Sans"
                              pdfFontName="fonts/DejaVuSans.ttf"
                              pdfEncoding="Identity-H"
                              isPdfEmbedded="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Patient: " + ($F{patientName} != null ? $F{patientName} : "")]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="10" y="40" width="250" height="15"/>
                    <textFieldExpression><![CDATA["Gender: " + ($F{gender} != null ? $F{gender} : "")]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement x="10" y="55" width="250" height="15"/>
                    <textFieldExpression><![CDATA["DateOfBirth: " + ($F{dateOfBirth} != null ? $F{dateOfBirth} : "")]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement x="10" y="70" width="250" height="15"/>
                    <textFieldExpression><![CDATA["Phone: " + ($F{phoneNumber} != null ? $F{phoneNumber} : "")]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement x="10" y="85" width="250" height="15"/>
                    <textFieldExpression><![CDATA["Status: " + ($F{status} != null ? $F{status}.name() : "")]]></textFieldExpression>
                </textField>

            </frame>


            <!-- Order Info Box -->
            <frame>
                <reportElement x="285" y="0" width="270" height="110"  backcolor="#BDC3C7" mode="Opaque"/>
                <staticText>
                    <reportElement x="0" y="0" width="270" height="20" forecolor="#1F3B63" mode="Opaque" backcolor="#AAB0B7"/>
                    <textElement textAlignment="Center">
                        <font isBold="true" size="12"/>
                    </textElement>
                    <text><![CDATA[ORDER DETAILS]]></text>
                </staticText>
                <textField>
                    <reportElement x="10" y="25" width="250" height="15"/>
                    <textFieldExpression><![CDATA["Order ID: " + ($F{id} != null ? $F{id} : "")]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="10" y="40" width="250" height="15"/>
                    <textFieldExpression><![CDATA["Created By: " + ($F{createdBy} != null ? $F{createdBy}.toString() : "")]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="10" y="55" width="250" height="15"/>
                    <textFieldExpression><![CDATA["Created On: " + ($F{createdAt} != null
                     ? new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm:ss")
                    .format(java.sql.Timestamp.valueOf($F{createdAt}))
                    : "")]]></textFieldExpression>
                </textField>
                <!--            <textField>-->
                <!--                <reportElement x="0" y="105" width="555" height="18"/>-->
                <!--                <textFieldExpression><![CDATA["Created By: " + ($F{createdBy} != null ? $F{createdBy}.toString() : "")-->
                <!--                + " | Created On: " + ($F{createdAt} != null-->
                <!--                     ? new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm:ss")-->
                <!--                    .format(java.sql.Timestamp.valueOf($F{createdAt}))-->
                <!--                    : "")]]></textFieldExpression>-->
                <!--            </textField>-->
                <textField>
                    <reportElement x="10" y="70" width="250" height="15"/>
                    <textFieldExpression><![CDATA["Run By: " + ($F{runBy} != null ? $F{runBy}.toString() : "")]]></textFieldExpression>
                </textField>

                <textField>
                    <reportElement x="10" y="85" width="250" height="15"/>
                    <textFieldExpression><![CDATA["Run On: " + ($F{runOn} != null ? $F{runOn}.toString() : "")]]></textFieldExpression>
                </textField>
            </frame>
<!--            <textField>-->
<!--                <reportElement x="0" y="125" width="555" height="18"/>-->
<!--                <textFieldExpression><![CDATA["Run By: " + ($F{runBy} != null ? $F{runBy}.toString() : "")-->
<!--                + " | Run On: " + ($F{runOn} != null ? $F{runOn}.toString() : "")]]></textFieldExpression>-->
<!--            </textField>-->
<!--            <textField>-->
<!--                <reportElement x="0" y="115" width="555" height="18"/>-->
<!--                <textElement>-->
<!--                    <font fontName="DejaVu Sans"-->
<!--                          pdfFontName="fonts/DejaVuSans.ttf"-->
<!--                          pdfEncoding="Identity-H"-->
<!--                          isPdfEmbedded="true"/>-->
<!--                </textElement>-->
<!--                <textFieldExpression><![CDATA["Order Comments: " + ($F{orderComments} != null ? $F{orderComments} : "")]]></textFieldExpression>-->
<!--            </textField>-->
        </band>
    </detail>

    <!-- ==================== SUMMARY (TABLE) ==================== -->
    <summary>
        <band height="100" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20" forecolor="#1F3B63"/>
                <textElement textAlignment="Center">
                    <font isBold="true" size="14"/>
                </textElement>
                <text><![CDATA[TEST RESULTS AND COMMENTS]]></text>
            </staticText>

            <componentElement>
                <reportElement x="0" y="25" width="555" height="1" positionType="Float"  />

                <c:table>
                    <datasetRun subDataset="TestResultDataset">
                        <dataSourceExpression><![CDATA[
                            new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{results} != null ? $F{results} : java.util.Collections.emptyList())
                        ]]></dataSourceExpression>
                    </datasetRun>

                    <!-- Column 1: Parameter -->
                    <c:column width="100">
                        <c:columnHeader height="20">
                            <staticText>
                                <reportElement x="0" y="0" width="100" height="20" backcolor="#1F3B63" mode="Opaque" forecolor="#FFFFFF"/>
                                <box>
                                    <pen lineWidth="1" lineColor="#9E9E9E"/>
                                </box>
                                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                                <text><![CDATA[Parameter]]></text>
                            </staticText>
                        </c:columnHeader>
                        <c:detailCell height="20">
                            <textField isStretchWithOverflow="true" >
                                <reportElement x="0" y="0" width="100" height="20"/>
                                <box>
                                    <pen lineWidth="1" lineColor="#9E9E9E"/>
                                </box>
                                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                                <textFieldExpression><![CDATA[$F{parameterName} != null ? $F{parameterName} : ""]]></textFieldExpression>
                            </textField>
                        </c:detailCell>
                    </c:column>

                    <!-- Column 2: Value -->
                    <c:column width="70">
                        <c:columnHeader height="20">
                            <staticText>
                                <reportElement x="0" y="0" width="70" height="20" backcolor="#1F3B63" mode="Opaque" forecolor="#FFFFFF"/>
                                <box>
                                    <pen lineWidth="1" lineColor="#9E9E9E"/>
                                </box>
                                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                                <text><![CDATA[Value]]></text>
                            </staticText>
                        </c:columnHeader>
                        <c:detailCell height="20">
                            <textField isStretchWithOverflow="true">
                                <reportElement x="0" y="0" width="70" height="20"/>
                                <box>
                                    <pen lineWidth="1" lineColor="#9E9E9E"/>
                                </box>
                                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                                <textFieldExpression><![CDATA[$F{value} != null ? $F{value} : ""]]></textFieldExpression>
                            </textField>
                        </c:detailCell>
                    </c:column>

                    <!-- Column 3: Flag -->
                    <c:column width="80">
                        <c:columnHeader height="20">
                            <staticText>
                                <reportElement x="0" y="0" width="80" height="20" backcolor="#1F3B63" mode="Opaque" forecolor="#FFFFFF"/>
                                <box>
                                    <pen lineWidth="1" lineColor="#9E9E9E"/>
                                </box>
                                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                                <text><![CDATA[Flag]]></text>
                            </staticText>
                        </c:columnHeader>
                        <c:detailCell height="20">
                            <textField isStretchWithOverflow="true">
                                <reportElement x="0" y="0" width="80" height="20"/>
                                <box>
                                    <pen lineWidth="1" lineColor="#9E9E9E"/>
                                </box>
                                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                                <textFieldExpression><![CDATA[
    $F{flagStatus} == null ? "" :
    $F{flagStatus}.name().equals("N") ? "Normal" :
    $F{flagStatus}.name().equals("H") ? "High" :
    $F{flagStatus}.name().equals("L") ? "Low" :
    $F{flagStatus}.name().equals("C") ? "Critical" :
    $F{flagStatus}.name()
]]></textFieldExpression>

                            </textField>
                        </c:detailCell>
                    </c:column>

<!--                    &lt;!&ndash; Column 4: Status &ndash;&gt;-->
<!--                    <c:column width="80">-->
<!--                        <c:columnHeader height="20">-->
<!--                            <staticText>-->
<!--                                <reportElement x="0" y="0" width="80" height="20" backcolor="#1F3B63" mode="Opaque" forecolor="#FFFFFF"/>-->
<!--                                <box>-->
<!--                                    <pen lineWidth="1" lineColor="#9E9E9E"/>-->
<!--                                </box>-->
<!--                                <textElement textAlignment="Center" verticalAlignment="Middle"/>-->
<!--                                <text><![CDATA[Status]]></text>-->
<!--                            </staticText>-->
<!--                        </c:columnHeader>-->
<!--                        <c:detailCell height="20">-->
<!--                            <textField textAdjust="StretchHeight">-->
<!--                                <reportElement x="0" y="0" width="80" height="20"/>-->
<!--                                <box>-->
<!--                                    <pen lineWidth="1" lineColor="#9E9E9E"/>-->
<!--                                </box>-->
<!--                                <textElement textAlignment="Center" verticalAlignment="Middle"/>-->
<!--                                <textFieldExpression><![CDATA[$F{status} != null ? $F{status}.name() : ""]]></textFieldExpression>-->
<!--                            </textField>-->
<!--                        </c:detailCell>-->
<!--                    </c:column>-->

<!--                    <c:column width="305">-->
<!--                        <c:columnHeader height="20">-->
<!--                            <staticText>-->
<!--                                &lt;!&ndash; Column 5: Comments &ndash;&gt;-->
<!--                                <reportElement x="0" y="0" width="305" height="20" backcolor="#1F3B63" mode="Opaque" forecolor="#FFFFFF"/>-->
<!--                                <box>-->
<!--                                    <pen lineWidth="1" lineColor="#9E9E9E"/>-->
<!--                                </box>-->
<!--                                <textElement textAlignment="Center" verticalAlignment="Middle"/>-->
<!--                                <text><![CDATA[Comments]]></text>-->
<!--                            </staticText>-->
<!--                        </c:columnHeader>-->
<!--                        <c:detailCell height="20">-->
<!--                            <textField textAdjust="StretchHeight">-->
<!--                                <reportElement x="0" y="0" width="305" height="20"/>-->
<!--                                <box>-->
<!--                                    <pen lineWidth="1" lineColor="#9E9E9E"/>-->
<!--                                </box>-->
<!--                                <textElement textAlignment="Center" verticalAlignment="Middle">-->
<!--                                    <font fontName="DejaVu Sans"-->
<!--                                          pdfFontName="fonts/DejaVuSans.ttf"-->
<!--                                          pdfEncoding="Identity-H"-->
<!--                                          isPdfEmbedded="true"/>-->
<!--                                </textElement>-->
<!--                                <textFieldExpression><![CDATA[$F{reviewText} != null ? $F{reviewText} : ""]]></textFieldExpression>-->
<!--                            </textField>-->
<!--                        </c:detailCell>-->
<!--                    </c:column>-->

                </c:table>
            </componentElement>

            <!-- Footer trang cuối -->
            <!-- ORDER COMMENTS TITLE -->
            <staticText>
                <reportElement x="0" y="0" width="555" height="15" forecolor="#1F3B63" positionType="Float"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[ORDER COMMENTS]]></text>
            </staticText>

            <!-- ĐƯỜNG GẠCH NGANG -->
            <line>
                <reportElement x="0" y="0" width="555" height="1" forecolor="#000000" positionType="Float"/>
            </line>

            <!-- NỘI DUNG ORDER COMMENTS -->
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="555" height="20" positionType="Float"/>
                <textElement>
                    <font fontName="DejaVu Sans"
                          pdfFontName="fonts/DejaVuSans.ttf"
                          pdfEncoding="Identity-H"
                          isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{orderComments} != null ? "• " + $F{orderComments}.replace(",", "\n• "): ""]]></textFieldExpression>
            </textField>

            <image>
                <reportElement x="0" y="0" width="80" height="80" forecolor="#566573" positionType="Float"/>
                <imageExpression><![CDATA["images/QR-Code.png"]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="370" y="0" width="200" height="20" positionType="Float"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans"
                          pdfFontName="fonts/DejaVuSans.ttf"
                          pdfEncoding="Identity-H"
                          isPdfEmbedded="true"
                    isBold="true"/>
                </textElement>
                <text><![CDATA[Bác sĩ phụ trách]]></text>
            </staticText>

            <image>
                <reportElement x="410" y="0" width="150" height="40" positionType="Float" />
                <imageExpression><![CDATA["images/doctor-signature.png"]]></imageExpression>
            </image>

            <staticText>
                <reportElement x="0" y="0" width="555" height="15" positionType="Float"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans"
                          pdfFontName="fonts/DejaVuSans.ttf"
                          pdfEncoding="Identity-H"
                          isPdfEmbedded="true"
                          size="10"
                          isItalic="true"/>
                </textElement>

                <text><![CDATA[Đây là tài liệu nội bộ của bệnh viện. Không chỉnh sửa khi chưa được authorized.]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
